---
import type { ITechnologiesUsed } from "../types/index.ts";
import { Icon } from "astro-icon/components";
import Badge from "./Badge.astro";

interface Props {
  technologies: ITechnologiesUsed[];
}

const { technologies } = Astro.props;
---

<div class="flex gap-2.5 flex-wrap items-center">
  {
    technologies.map((technology) => (
      <Badge label={technology.label}>
        <Icon name={technology.icon} class="size-5 shrink-0" />
      </Badge>
    ))
  }
</div>
