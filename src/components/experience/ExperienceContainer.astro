---
import type { IExperience } from "../../types";
import { Icon } from "astro-icon/components";
import Badge from "../Badge.astro";
import CustomParagraph from "../../components/CustomParagraph.astro";
import CustomH3 from "../../components/CustomH3.astro";

interface Props {
  experience: IExperience;
}

const { experience } = Astro.props;
const { date, description, settings, tags, title } = experience;
const { hasProjectUrls, projectUrl } = settings;
---

<article class="experience-card">
  <div class="experience-date-col">
    <span class="job-date">{date}</span>
  </div>
  <div class="experience-content-col">
    <CustomH3 className="text-purple-300">
      {
        hasProjectUrls ? (
          <a
            href={projectUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="experience-title-link"
          >
            <span>{title}</span>
            <Icon name="tabler:external-link" class="redirect-icon" />
          </a>
        ) : (
          <span>{title}</span>
        )
      }
    </CustomH3>
    <CustomParagraph>{description}</CustomParagraph>
    <div class="experience-tags">
      {tags.map((tag) => <Badge label={tag} />)}
    </div>
  </div>
</article>

<style>
  .experience-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem 1.75rem;
    background: rgba(30, 41, 59, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1rem;
    backdrop-filter: blur(8px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    box-sizing: border-box;
    width: 100%;
  }

  .experience-card:hover {
    border-color: rgba(147, 197, 253, 0.35);
    background: rgba(30, 41, 59, 0.7);
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
  }

  .experience-date-col {
    display: flex;
    align-items: center;
  }

  .job-date {
    font-size: 0.85rem;
    font-weight: 500;
    color: #94a3b8;
    text-transform: capitalize;
    letter-spacing: 0.025em;
  }

  .experience-content-col {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .experience-title-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .experience-title-link:hover {
    color: #93c5fd;
  }

  .redirect-icon {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .experience-title-link:hover .redirect-icon {
    transform: translate(2px, -2px);
  }

  .experience-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }
</style>
