---
import type { IExperience } from "../../types";
import Badge from "../Badge.astro";
import CustomParagraph from "../../components/CustomParagraph.astro";
import CustomH3 from "../../components/CustomH3.astro";
import RedirectIcon from "../icons/RedirectIcon.astro";

interface Props {
  experience: IExperience;
}

const { experience } = Astro.props;
const { date, description, settings, tags, title } = experience;
const { hasProjectUrls, projectUrl } = settings;
---

<article class="experience-card">
  <div class="experience-date-col">
    <span class="job-date">{date}</span>
  </div>
  <div class="experience-content-col">
    <CustomH3 className="text-purple-300">
      {
        hasProjectUrls ? (
          <a
            href={projectUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="experience-title-link"
          >
            <span>{title}</span>
            <RedirectIcon class="redirect-icon" />
          </a>
        ) : (
          <span>{title}</span>
        )
      }
    </CustomH3>
    <CustomParagraph>{description}</CustomParagraph>
    <div class="experience-tags">
      {tags.map((tag) => <Badge label={tag} />)}
    </div>
  </div>
</article>

<style>
  .experience-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    box-sizing: border-box;
    padding: 1.5rem;
    background-color: rgba(30, 41, 59, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 1rem;
    transition: background-color 0.25s ease, border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }

  .experience-card:hover {
    background-color: rgba(30, 41, 59, 0.65);
    border-color: rgba(168, 85, 247, 0.35);
    transform: translateY(-2px);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.35);
  }

  .experience-date-col {
    display: flex;
    align-items: flex-start;
  }

  .job-date {
    font-size: 0.8rem;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 500;
  }

  .experience-content-col {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
    width: 100%;
  }

  .experience-title-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
    flex-wrap: wrap;
  }

  .experience-title-link:hover {
    color: #c084fc;
  }

  .experience-title-link:hover :global(.redirect-icon) {
    transform: translate(2px, -2px);
    color: #c084fc;
  }

  :global(.redirect-icon) {
    width: 1.1rem;
    height: 1.1rem;
    display: inline-block;
    vertical-align: middle;
    flex-shrink: 0;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .experience-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    width: 100%;
    margin-top: 0.25rem;
  }

  @media (min-width: 800px) {
    .experience-card {
      display: grid;
      grid-template-columns: 12.5rem minmax(0, 1fr);
      gap: 1.5rem;
      padding: 1.5rem;
    }

    .experience-date-col {
      padding-top: 0.2rem;
    }
  }

  @media (max-width: 799px) {
    .experience-card {
      padding: 1.25rem 1rem;
      gap: 0.6rem;
    }

    .job-date {
      font-size: 0.75rem;
    }
  }
</style>
