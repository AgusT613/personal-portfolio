---
import type { IExperience } from "../../types";
import { Icon } from "astro-icon/components";
import Badge from "../Badge.astro";
import CustomParagraph from "../../components/CustomParagraph.astro";
import CustomH3 from "../../components/CustomH3.astro";

interface Props {
  experience: IExperience;
  isLast?: boolean;
}

const { experience, isLast = false } = Astro.props;
const { date, description, settings, tags, title } = experience;
const { hasProjectUrls, projectUrl } = settings;
---

<li class={`timeline-item ${isLast ? "is-last" : ""}`}>
  <!-- Timeline vertical line & node -->
  <div class="timeline-axis" aria-hidden="true">
    <div class="timeline-node">
      <Icon name="tabler:briefcase" class="timeline-node-icon" />
    </div>
    {!isLast && <div class="timeline-line" />}
  </div>

  <!-- Timeline Card -->
  <article class="timeline-card">
    <header class="timeline-card-header">
      <div class="timeline-date-badge">
        <Icon name="tabler:calendar" class="date-icon" />
        <time>{date}</time>
      </div>

      <CustomH3 className="text-purple-300">
        {
          hasProjectUrls ? (
            <a
              href={projectUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="experience-title-link"
            >
              <span>{title}</span>
              <Icon name="tabler:external-link" class="redirect-icon" />
            </a>
          ) : (
            <span>{title}</span>
          )
        }
      </CustomH3>
    </header>

    <div class="timeline-card-body">
      <CustomParagraph>{description}</CustomParagraph>
    </div>

    <footer class="timeline-card-footer">
      <div class="experience-tags">
        {tags.map((tag) => <Badge label={tag} />)}
      </div>
    </footer>
  </article>
</li>

<style>
  .timeline-item {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1.5rem;
    position: relative;
    padding-bottom: 2.5rem;
  }

  .timeline-item.is-last {
    padding-bottom: 0;
  }

  .timeline-axis {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .timeline-node {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: #0f172a;
    border: 2px solid #a855f7;
    color: #c084fc;
    box-shadow: 0 0 16px rgba(168, 85, 247, 0.35);
    z-index: 2;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .timeline-node-icon {
    width: 1.15rem;
    height: 1.15rem;
  }

  .timeline-line {
    width: 2px;
    flex: 1;
    background: linear-gradient(
      180deg,
      rgba(168, 85, 247, 0.6) 0%,
      rgba(59, 130, 246, 0.4) 70%,
      rgba(59, 130, 246, 0.1) 100%
    );
    margin-top: 0.5rem;
    border-radius: 9999px;
  }

  .timeline-item:hover .timeline-node {
    transform: scale(1.1);
    border-color: #c084fc;
    color: #f3e8ff;
    box-shadow: 0 0 24px rgba(168, 85, 247, 0.6);
  }

  .timeline-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem 1.75rem;
    background: rgba(30, 41, 59, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1rem;
    backdrop-filter: blur(8px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    box-sizing: border-box;
    width: 100%;
    position: relative;
  }

  .timeline-card:hover {
    border-color: rgba(168, 85, 247, 0.4);
    background: rgba(30, 41, 59, 0.7);
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .timeline-card-header {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .timeline-date-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    width: fit-content;
    padding: 0.25rem 0.65rem;
    background: rgba(168, 85, 247, 0.12);
    border: 1px solid rgba(168, 85, 247, 0.28);
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #d8b4fe;
    letter-spacing: 0.02em;
    text-transform: capitalize;
  }

  .date-icon {
    width: 0.95rem;
    height: 0.95rem;
    color: #c084fc;
  }

  .experience-title-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .experience-title-link:hover {
    color: #c084fc;
  }

  .redirect-icon {
    width: 1.15rem;
    height: 1.15rem;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .experience-title-link:hover .redirect-icon {
    transform: translate(2px, -2px);
  }

  .timeline-card-body {
    display: flex;
    flex-direction: column;
  }

  .timeline-card-footer {
    display: flex;
    flex-direction: column;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .experience-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  @media (max-width: 640px) {
    .timeline-item {
      grid-template-columns: 2rem 1fr;
      gap: 1rem;
      padding-bottom: 2rem;
    }

    .timeline-node {
      width: 2rem;
      height: 2rem;
    }

    .timeline-node-icon {
      width: 0.95rem;
      height: 0.95rem;
    }

    .timeline-card {
      padding: 1.25rem 1rem;
    }

    .timeline-date-badge {
      font-size: 0.75rem;
      padding: 0.2rem 0.5rem;
    }
  }
</style>
