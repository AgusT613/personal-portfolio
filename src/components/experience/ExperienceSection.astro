---
import TitleSection from "../TitleSection.astro";
import ExperienceContainer from "./ExperienceContainer.astro";
import { EXPERIENCES_DATA } from "../../data/experience";
import { useTranslations } from "../../i18n/utils";
import type { IExperience } from "../../types";

const t = useTranslations(Astro.currentLocale);

const experiences: IExperience[] = EXPERIENCES_DATA.map((exp) => ({
  title: t(`experience.${exp.id}.title` as any),
  date: t(`experience.${exp.id}.date` as any),
  description: t(`experience.${exp.id}.description` as any),
  tags: exp.tags,
  settings: {
    hasProjectUrls: Boolean(exp.projectUrl),
    projectUrl: exp.projectUrl ?? "",
  },
}));
---

<section id="experience" class="experience-section">
  <TitleSection>{t("experience.sectionTitle")}</TitleSection>
  <div class="experience-wrapper">
    {
      experiences.map((experience) => (
        <ExperienceContainer experience={experience} />
      ))
    }
  </div>
</section>

<style>
  .experience-section {
    display: flex;
    flex-direction: column;
    padding-top: 7rem;
    width: 100%;
    box-sizing: border-box;
  }

  .experience-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
    box-sizing: border-box;
  }
</style>
