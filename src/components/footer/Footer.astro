---
import "./footer.css";
import FOOTER_LINKS from "./footerLinks";
import { useTranslations } from "../../i18n/utils";
import { Icon } from "astro-icon/components";

const t = useTranslations(Astro.currentLocale);
---

<footer class="footer">
  <div class="footer-container">
    <!-- Contact Me Section -->
    <section id="contact" class="footer-contact-section">
      <h2 class="contact-title">
        {t("footer.contact")}
      </h2>
      <div class="footer-links-container">
        {
          FOOTER_LINKS.map((link) => (
            <a
              href={link.href}
              class="footer-link-item"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={link.label}
              title={link.label}
            >
              <Icon name={link.icon} class="footer-icon-url" />
            </a>
          ))
        }
      </div>
    </section>

    <div class="footer-divider" aria-hidden="true"></div>

    <div class="footer-developed-by">
      <span class="developed-with-title">
        {t("footer.developedWith")}
      </span>
      <a
        href="https://astro.build/"
        class="astro-link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Astro"
      >
        <Icon name="logos:astro-icon" class="footer-icon-url" />
      </a>
    </div>
  </div>
</footer>
