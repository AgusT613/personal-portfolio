---
import "./footer.css";
import FOOTER_LINKS from "./footerLinks";
import { useTranslations } from "../../i18n/utils";
import { Icon } from "astro-icon/components";

const t = useTranslations(Astro.currentLocale);
---

<footer class="px-3 py-6 flex justify-center items-center gap-10 footer">
  <!-- Contact Me Section -->
  <section id="contact" class="flex items-center justify-center gap-6">
    <h2 class="text-lg text-center tracking-wider contact-title">
      {t("footer.contact")}
    </h2>
    {
      FOOTER_LINKS.map((link) => (
        <a href={link.href} class="hover:scale-110" target="_blank" aria-label={link.label}>
          <Icon name={link.icon} class="size-6 footer-icon-url shrink-0" />
        </a>
      ))
    }
  </section>
  <div class="separate-line"></div>
  <span
    class="text-lg flex items-center justify-center gap-5 tracking-wider text-purple-300 developed-with-title"
  >
    {t("footer.developedWith")}
    <a href="https://astro.build/" class="hover:scale-110" target="_blank" aria-label="Astro">
      <Icon name="logos:astro-icon" class="size-6 footer-icon-url shrink-0" />
    </a>
  </span>
</footer>
