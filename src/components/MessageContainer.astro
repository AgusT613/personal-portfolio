---
import ActionDoneIcon from "../components/icons/ActionDoneIcon.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const t = useTranslations(getLangFromUrl(Astro.url));
---

<aside
  id="copy-to-clipboard-msg-container"
  class="toast-container"
  role="status"
  aria-live="polite"
  aria-atomic="true"
>
  <div class="toast-card">
    <span class="toast-icon-wrapper">
      <ActionDoneIcon class="toast-icon" />
    </span>
    <span class="toast-text">{t("message.container")}</span>
  </div>
</aside>

<style>
  .toast-container {
    position: fixed;
    top: 5.25rem;
    left: 50%;
    transform: translateX(-50%) translateY(-1rem);
    z-index: 100;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .toast-container.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
  }

  .toast-card {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.6rem 1.25rem;
    background-color: rgba(30, 41, 59, 0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(52, 211, 153, 0.45);
    border-radius: 9999px;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5),
      0 0 20px rgba(16, 185, 129, 0.2);
    box-sizing: border-box;
    white-space: nowrap;
    user-select: none;
  }

  .toast-icon-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #34d399;
    flex-shrink: 0;
  }

  :global(.toast-icon) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .toast-text {
    font-size: 0.9rem;
    font-weight: 500;
    color: #f1f5f9;
    letter-spacing: 0.025em;
  }

  @media (max-width: 480px) {
    .toast-container {
      top: 4.75rem;
      width: calc(100% - 2rem);
      left: 1rem;
      transform: translateY(-1rem);
    }

    .toast-container.is-visible {
      transform: translateY(0);
    }

    .toast-card {
      width: 100%;
      justify-content: center;
      padding: 0.55rem 1rem;
    }
  }
</style>
