---
import "./about_me.css";
import CustomParagraph from "../CustomParagraph.astro";
import TitleSection from "../TitleSection.astro";
import TransformString from "../TransformString.astro";
import { useTranslations } from "../../i18n/utils";

const t = useTranslations(Astro.currentLocale);
---

<section id="about-me" class="flex flex-col justify-center py-28">
  <TitleSection>{t("about.sectionTitle")}</TitleSection>
  <article class="gap-6 grid grid-cols-[11rem_1fr]">
    <picture>
      <img
        src="/portrait.jpg"
        alt={t("about.profileImageAlt")}
        class="rounded-3xl object-cover object-top size-full"
      />
    </picture>
    <div class="flex flex-col gap-4">
      <CustomParagraph>
        <TransformString text={t("about.firstParagraph")} />
      </CustomParagraph>
      <CustomParagraph>
        <TransformString text={t("about.secondParagraph")} />
      </CustomParagraph>
      <CustomParagraph>
        <TransformString text={t("about.thirdParagraph")} />
      </CustomParagraph>
    </div>
  </article>
</section>
