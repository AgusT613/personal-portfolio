---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<span class="badge">
  <slot />
  <span class="badge-label">{label}</span>
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    max-width: 100%;
    gap: 0.4rem;
    padding: 0.28rem 0.75rem;
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.12), rgba(20, 184, 166, 0.16));
    border: 1px solid rgba(52, 211, 153, 0.32);
    border-radius: 9999px;
    font-size: 0.815rem;
    font-weight: 500;
    color: #6ee7b7;
    letter-spacing: 0.025em;
    user-select: none;
    box-sizing: border-box;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15), inset 0 1px 0 rgba(255, 255, 255, 0.04);
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .badge:hover {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.22), rgba(20, 184, 166, 0.28));
    border-color: rgba(52, 211, 153, 0.6);
    color: #a7f3d0;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .badge :global(svg) {
    flex-shrink: 0;
    color: #34d399;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .badge:hover :global(svg) {
    color: #6ee7b7;
    transform: scale(1.08);
  }

  .badge-label {
    overflow-wrap: break-word;
    word-break: break-word;
  }

  @media (max-width: 570px) {
    .badge {
      font-size: 0.75rem;
      padding: 0.22rem 0.55rem;
      gap: 0.3rem;
    }
  }

  @media (max-width: 400px) {
    .badge {
      font-size: 0.7rem;
      padding: 0.18rem 0.48rem;
    }
  }
</style>
