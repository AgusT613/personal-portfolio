---
import "./header.css";
import DropDownIcon from "../../components/icons/DropDownIcon.astro";
import CloseIcon from "../../components/icons/CloseIcon.astro";
import LanguagePicker from "../LanguagePicker.astro";
import { useTranslations } from "../../i18n/utils";

const t = useTranslations(Astro.currentLocale);

const navItems = [
  {
    id: "#top",
    label: "top",
    title: t("header.nav.top"),
  },
  {
    id: "#experience",
    label: "experience",
    title: t("header.nav.experience"),
  },
  {
    id: "#projects",
    label: "projects",
    title: t("header.nav.projects"),
  },
  {
    id: "#about-me",
    label: "about-me",
    title: t("header.nav.aboutMe"),
  },
  {
    id: "#contact",
    label: "contact",
    title: t("header.nav.contact"),
  },
];
---

<header id="nav-header" class="header">
  <div class="header-container">
    <div class="header-left">
      <LanguagePicker />
    </div>

    <nav class="desktop-nav" id="desktop-nav-bar-container">
      {
        navItems.map((item) => (
          <a
            href={item.id}
            class="nav-link"
            aria-label={item.label}
          >
            {item.title}
          </a>
        ))
      }
    </nav>

    <div class="header-right">
      <button
        id="drop-drown-btn"
        class="mobile-menu-btn"
        type="button"
        aria-label="Abrir menú"
      >
        <DropDownIcon class="mobile-icon" id="drop-down-icon" />
        <CloseIcon class="mobile-icon hidden" id="close-icon" />
      </button>
    </div>
  </div>

  <nav
    id="drop-down-nav-bar-container"
    class="mobile-nav-overlay hidden"
  >
    <div class="mobile-nav-content">
      {
        navItems.map((item) => (
          <a
            href={item.id}
            class="mobile-nav-link"
            aria-label={item.label}
          >
            {item.title}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script src="./header.ts"></script>
