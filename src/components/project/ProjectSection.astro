---
import TitleSection from "../TitleSection.astro";
import ProjectContainer from "./ProjectContainer.astro";
import { PROJECTS_DATA } from "../../data/projects";
import { useTranslations } from "../../i18n/utils";
import type { IProject, IProjectLinks } from "../../types";

const t = useTranslations(Astro.currentLocale);

const projects: IProject[] = PROJECTS_DATA.map((project) => {
  const links: IProjectLinks[] = project.links.map((link) => {
    let label = t("project.webpageBtnLabel");
    let icon = "tabler:external-link";

    if (link.type === "github-front") {
      label = "Frontend";
      icon = "tabler:brand-github";
    } else if (link.type === "github-back") {
      label = "Backend";
      icon = "tabler:brand-github";
    }

    return {
      href: link.href,
      label,
      icon,
    };
  });

  return {
    name: project.nameKey ? t(project.nameKey as any) : project.name!,
    description: t(`project.${project.translationId}.description` as any),
    technologies: project.technologies,
    image: {
      src: project.image,
      alt: t(`project.${project.translationId}.imageAlt` as any),
    },
    links,
  };
});
---

<section id="projects" class="project-section">
  <TitleSection>{t("project.sectionTitle")}</TitleSection>
  <div class="project-grid">
    {projects.map((project) => <ProjectContainer project={project} />)}
  </div>
</section>

<style>
  .project-section {
    display: flex;
    flex-direction: column;
    padding-top: 7rem;
    width: 100%;
    box-sizing: border-box;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 2rem;
    width: 100%;
    box-sizing: border-box;
  }

  @media (max-width: 900px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
