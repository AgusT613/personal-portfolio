---
import TechnologiesUsed from "../../components/TechnologiesUsed.astro";
import ProjectLinks from "./ProjectLinks.astro";
import type { IProject } from "../../types/index.ts";
import CustomParagraph from "../CustomParagraph.astro";
import CustomH3 from "../CustomH3.astro";

interface Props {
  project: IProject;
}

const { project } = Astro.props;
const { description, image, links, name, technologies } = project;
const techDataAttr = technologies.map((t) => t.label.toLowerCase()).join("|");
---

<article class="project-card" data-technologies={techDataAttr}>
  <div class="project-image-wrapper">
    <img
      class="project-image"
      src={image.src}
      alt={image.alt}
      loading="lazy"
    />
  </div>

  <div class="project-content">
    <CustomH3 className="text-purple-300">
      <span class="project-title">{name}</span>
    </CustomH3>

    <CustomParagraph>{description}</CustomParagraph>

    <div class="project-techs">
      <TechnologiesUsed technologies={technologies} />
    </div>

    <div class="project-links-wrapper">
      <ProjectLinks links={links} />
    </div>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    width: 100%;
    box-sizing: border-box;
    padding: 1.75rem;
    background-color: rgba(30, 41, 59, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 1rem;
    box-shadow: 0 4px 15px -3px rgba(0, 0, 0, 0.25);
    transition: background-color 0.25s ease, border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }

  .project-card:hover {
    background-color: rgba(30, 41, 59, 0.65);
    border-color: rgba(168, 85, 247, 0.35);
    transform: translateY(-3px);
    box-shadow: 0 12px 25px -5px rgba(0, 0, 0, 0.35);
  }

  .project-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 14rem;
    border-radius: 0.75rem;
    overflow: hidden;
    margin-bottom: 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background-color: #0f172a;
    flex-shrink: 0;
  }

  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
    transition: transform 0.3s ease;
  }

  .project-card:hover .project-image {
    transform: scale(1.03);
  }

  .project-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 1rem;
    min-width: 0;
  }

  .project-title {
    display: block;
    word-break: break-word;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .project-techs {
    width: 100%;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .project-links-wrapper {
    display: flex;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    margin-top: 0.5rem;
  }

  @media (max-width: 600px) {
    .project-card {
      padding: 1.25rem 1rem;
    }

    .project-image-wrapper {
      margin-bottom: 1rem;
    }
  }

  .project-card[data-hidden="true"] {
    display: none !important;
  }

  /* Featured first project on desktop */
  @media (min-width: 901px) {
    :global(.project-grid:not(.is-filtered)) .project-card:first-child,
    .project-card.is-featured {
      grid-column: span 2;
      display: grid;
      grid-template-columns: 1.15fr 1fr;
      gap: 2rem;
      align-items: stretch;
      padding: 2rem;
      background: linear-gradient(135deg, rgba(30, 41, 59, 0.45) 0%, rgba(30, 41, 59, 0.25) 100%);
      border-color: rgba(168, 85, 247, 0.2);
    }

    :global(.project-grid:not(.is-filtered)) .project-card:first-child:hover,
    .project-card.is-featured:hover {
      border-color: rgba(168, 85, 247, 0.45);
      box-shadow: 0 16px 32px -6px rgba(0, 0, 0, 0.4);
    }

    :global(.project-grid:not(.is-filtered)) .project-card:first-child .project-image-wrapper,
    .project-card.is-featured .project-image-wrapper {
      margin-bottom: 0;
      height: 100%;
      max-height: none;
      aspect-ratio: auto;
      min-height: 280px;
    }

    :global(.project-grid:not(.is-filtered)) .project-card:first-child .project-image,
    .project-card.is-featured .project-image {
      height: 100%;
      width: 100%;
      object-fit: cover;
      object-position: top center;
    }

    :global(.project-grid:not(.is-filtered)) .project-card:first-child .project-content,
    .project-card.is-featured .project-content {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      height: 100%;
      gap: 1.25rem;
    }

    :global(.project-grid:not(.is-filtered)) .project-card:first-child .project-title,
    .project-card.is-featured .project-title {
      font-size: 1.5rem;
    }

    :global(.project-grid:not(.is-filtered)) .project-card:first-child .project-techs,
    .project-card.is-featured .project-techs {
      margin-top: auto;
      padding-top: 0.5rem;
    }

    :global(.project-grid:not(.is-filtered)) .project-card:first-child .project-links-wrapper,
    .project-card.is-featured .project-links-wrapper {
      margin-top: 0.5rem;
    }
  }
</style>
