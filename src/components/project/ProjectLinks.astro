---
import type { IProjectLinks } from "../../types";
import { Icon } from "astro-icon/components";
import CustomActionBtn from "../CustomActionBtn.astro";

interface Props {
  links: IProjectLinks[];
}

const { links } = Astro.props;
---

<div class="project-links">
  {
    links.map((link) => (
      <a href={link.href} target="_blank" rel="noopener noreferrer" class="project-link-item">
        <CustomActionBtn>
          <span>{link.label}</span>
          <Icon name={link.icon} class="size-4 shrink-0" />
        </CustomActionBtn>
      </a>
    ))
  }
</div>

<style>
  .project-links {
    display: flex;
    gap: 0.65rem;
    align-items: center;
    flex-wrap: wrap;
    width: 100%;
  }

  .project-link-item {
    text-decoration: none;
    display: inline-flex;
  }

  @media (max-width: 480px) {
    .project-links {
      gap: 0.5rem;
    }

    .project-link-item {
      flex: 1 1 calc(50% - 0.5rem);
      min-width: 8rem;
    }

    .project-link-item :global(.custom-action-btn) {
      width: 100%;
    }
  }
</style>
