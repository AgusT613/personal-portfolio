---
import "./hero.css";
import Badge from "../../components/Badge.astro";
import CopyEmailBtn from "../../components/CopyEmailBtn.astro";
import DownloadCVBtn from "../../components/DownloadCVBtn.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import KeyWord from "../KeyWord.astro";

const t = useTranslations(getLangFromUrl(Astro.url));
---

<section id="top" class="hero-section">
  <div class="hero-container">
    <div class="hero-content">
      <div class="hero-badges">
        <Badge label={t("hero.badge.webpages")} />
        <Badge label={t("hero.badge.apps")} />
        <Badge label={t("hero.badge.database")} />
        <Badge label={t("hero.badge.design")} />
      </div>

      <h1 class="greeting-title">
        {t("hero.greeting")}
      </h1>

      <article class="hero-description">
        <p>
          <KeyWord word={t("hero.years.of.experience") + " "} />
          {t("hero.description")}
        </p>
      </article>

      <div class="actions-btn-container">
        <CopyEmailBtn />
        <DownloadCVBtn />
      </div>
    </div>

    <div class="hero-avatar-wrapper">
      <div class="avatar-glow"></div>
      <img
        src="/profile_image.png"
        alt={t("hero.image.profile.alt")}
        class="hero-avatar"
      />
    </div>
  </div>
</section>
