---
import "./hero.css";
import Badge from "../../components/Badge.astro";
import CopyEmailBtn from "../../components/CopyEmailBtn.astro";
import DownloadCVBtn from "../../components/DownloadCVBtn.astro";
import TransformString from "../TransformString.astro";
import { useTranslations } from "../../i18n/utils";

const t = useTranslations(Astro.currentLocale);
---

<section id="top" class="hero-section">
  <div class="hero-container">
    <div class="hero-content">
      <div class="hero-badges">
        <Badge label={t("hero.badges.webpages")} />
        <Badge label={t("hero.badges.apps")} />
        <Badge label={t("hero.badges.database")} />
        <Badge label={t("hero.badges.design")} />
      </div>

      <h1 class="greeting-title">
        {t("hero.greeting")}
      </h1>

      <article class="hero-description">
        <p>
          <TransformString text={t("hero.description")} />
        </p>
      </article>

      <div class="actions-btn-container">
        <CopyEmailBtn />
        <DownloadCVBtn />
      </div>
    </div>

    <div class="hero-avatar-wrapper">
      <div class="avatar-glow"></div>
      <img
        src="/profile_image.png"
        alt={t("hero.imageProfileAlt")}
        class="hero-avatar"
      />
    </div>
  </div>
</section>
