---
import Layout from "../../layouts/Layout.astro";
import { useTranslations } from "../../i18n/utils";
import { locales } from "../../i18n/ui";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Icon } from "astro-icon/components";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const currentLocale = Astro.currentLocale ?? "es";
const t = useTranslations(currentLocale);
const homeUrl = getRelativeLocaleUrl(currentLocale, "");
const pdfUrl = t("hero.cvFileHref");
const downloadName = t("hero.cvFileName");
---

<Layout title={`${t("resume.pageTitle")} | Torres Agustín`}>
  <main class="resume-page">
    <div class="resume-header">
      <div class="resume-actions-left">
        <a href={homeUrl} class="back-btn" aria-label={t("resume.backToHome")}>
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M19 12H5m7 7-7-7 7-7"></path>
          </svg>
          <span>{t("resume.backToHome")}</span>
        </a>
      </div>

      <h1 class="resume-title">{t("resume.pageTitle")}</h1>

      <div class="resume-actions-right">
        <a
          href={pdfUrl}
          download={downloadName}
          class="download-btn"
          aria-label={t("resume.downloadPdf")}
        >
          <span>{t("resume.downloadPdf")}</span>
          <Icon name="tabler:download" class="download-icon" />
        </a>
      </div>
    </div>

    <!-- Toolbar del visor -->
    <div class="viewer-toolbar" id="viewer-toolbar">
      <div class="toolbar-group">
        <button
          type="button"
          class="toolbar-btn"
          id="zoom-out-btn"
          title={t("resume.zoomOut")}
          aria-label={t("resume.zoomOut")}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
        </button>
        <span class="zoom-level" id="zoom-level" aria-live="polite">100%</span>
        <button
          type="button"
          class="toolbar-btn"
          id="zoom-in-btn"
          title={t("resume.zoomIn")}
          aria-label={t("resume.zoomIn")}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="11" y1="8" x2="11" y2="14"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
        </button>
      </div>

      <div class="toolbar-separator"></div>

      <div class="toolbar-group">
        <button
          type="button"
          class="toolbar-btn text-btn"
          id="fit-width-btn"
          title={t("resume.fitWidth")}
        >
          {t("resume.fitWidth")}
        </button>
        <button
          type="button"
          class="toolbar-btn text-btn"
          id="fit-page-btn"
          title={t("resume.fitPage")}
        >
          {t("resume.fitPage")}
        </button>
      </div>
    </div>

    <!-- Contenedor del Visor PDF -->
    <div
      class="pdf-viewer-wrapper"
      id="pdf-viewer-wrapper"
      data-pdf-url={pdfUrl}
      data-loading-text={t("resume.loading")}
      data-error-text={t("resume.errorLoading")}
    >
      <div class="pdf-loading-state" id="pdf-loading">
        <div class="spinner"></div>
        <p>{t("resume.loading")}</p>
      </div>
      <div class="pdf-pages-container" id="pdf-pages-container"></div>
    </div>
  </main>
</Layout>

<style>
  .resume-page {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .resume-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .resume-title {
    font-size: 2rem;
    font-weight: 700;
    color: #e9d5ff;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1rem;
    background-color: rgba(30, 41, 59, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 0.6rem;
    color: #cbd5e1;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .back-btn:hover {
    background-color: rgba(51, 65, 85, 0.85);
    color: #ffffff;
    border-color: rgba(147, 197, 253, 0.4);
    transform: translateX(-2px);
  }

  .download-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1.25rem;
    background: linear-gradient(180deg, #2563eb 0%, #1d4ed8 100%);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 0.6rem;
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
    transition: all 0.2s ease;
  }

  .download-btn:hover {
    background: linear-gradient(180deg, #3b82f6 0%, #2563eb 100%);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(37, 99, 235, 0.45);
  }

  .download-icon {
    width: 1.15rem;
    height: 1.15rem;
  }

  .viewer-toolbar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 0.5rem 1rem;
    background: rgba(30, 41, 59, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.75rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
    align-self: center;
  }

  .toolbar-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .toolbar-separator {
    width: 1px;
    height: 1.25rem;
    background-color: rgba(255, 255, 255, 0.15);
  }

  .toolbar-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.4rem 0.6rem;
    background-color: rgba(51, 65, 85, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.4rem;
    color: #e2e8f0;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .toolbar-btn:hover {
    background-color: rgba(71, 85, 105, 0.85);
    color: #60a5fa;
  }

  .toolbar-btn.text-btn {
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.4rem 0.75rem;
  }

  .zoom-level {
    font-size: 0.85rem;
    font-weight: 600;
    color: #cbd5e1;
    min-width: 3rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .pdf-viewer-wrapper {
    position: relative;
    width: 100%;
    min-height: 70vh;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1rem;
    padding: 2rem 1rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow-x: auto;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }

  .pdf-loading-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 5rem 0;
    color: #94a3b8;
  }

  .spinner {
    width: 2.5rem;
    height: 2.5rem;
    border: 3px solid rgba(147, 197, 253, 0.2);
    border-top-color: #60a5fa;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .pdf-pages-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    width: 100%;
  }

  :global(.pdf-page-card) {
    background: #ffffff;
    border-radius: 0.5rem;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5);
    overflow: hidden;
    max-width: 100%;
  }

  :global(.pdf-page-canvas) {
    display: block;
    max-width: 100%;
    height: auto !important;
  }

  .error-message {
    padding: 2rem;
    text-align: center;
    color: #fca5a5;
    background-color: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.2);
    border-radius: 0.5rem;
    max-width: 32rem;
  }

  @media (max-width: 640px) {
    .resume-header {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
    }

    .resume-actions-left,
    .resume-actions-right {
      display: flex;
      justify-content: center;
    }

    .resume-title {
      font-size: 1.75rem;
    }

    .viewer-toolbar {
      flex-wrap: wrap;
      width: 100%;
      box-sizing: border-box;
    }

    .pdf-viewer-wrapper {
      padding: 1rem 0.5rem;
    }
  }
</style>

<script>
  // Polyfill Promise.withResolvers for older mobile browsers and webviews (iOS < 17.4, older Android)
  if (!("withResolvers" in Promise)) {
    (Promise as any).withResolvers = function <T>() {
      let resolve!: (value: T | PromiseLike<T>) => void;
      let reject!: (reason?: any) => void;
      const promise = new Promise<T>((res, rej) => {
        resolve = res;
        reject = rej;
      });
      return { promise, resolve, reject };
    };
  }

  import * as pdfjsLib from "pdfjs-dist";

  // Use locally served worker for high speed and reliability
  pdfjsLib.GlobalWorkerOptions.workerSrc = "/pdfjs/pdf.worker.min.mjs";

  const wrapper = document.getElementById("pdf-viewer-wrapper");
  const loading = document.getElementById("pdf-loading");
  const pagesContainer = document.getElementById("pdf-pages-container");
  const zoomInBtn = document.getElementById("zoom-in-btn");
  const zoomOutBtn = document.getElementById("zoom-out-btn");
  const fitWidthBtn = document.getElementById("fit-width-btn");
  const fitPageBtn = document.getElementById("fit-page-btn");
  const zoomLevelLabel = document.getElementById("zoom-level");

  const pdfUrl = wrapper?.dataset.pdfUrl;
  const errorText = wrapper?.dataset.errorText ?? "Error loading PDF";

  let currentPdfDoc: any = null;
  let currentScale = 1.0;
  const MIN_SCALE = 0.4;
  const MAX_SCALE = 3.0;

  function updateZoomLabel() {
    if (zoomLevelLabel) {
      zoomLevelLabel.textContent = `${Math.round(currentScale * 100)}%`;
    }
  }

  async function renderPages() {
    if (!currentPdfDoc || !pagesContainer) return;
    pagesContainer.innerHTML = "";

    // Cap devicePixelRatio at 2.0 on mobile devices to prevent canvas memory overflow in WebKit/Chrome
    const rawPixelRatio = window.devicePixelRatio || 1;
    const isMobile = window.innerWidth < 768;
    const pixelRatio = isMobile ? Math.min(2.0, rawPixelRatio) : rawPixelRatio;

    for (let pageNum = 1; pageNum <= currentPdfDoc.numPages; pageNum++) {
      const page = await currentPdfDoc.getPage(pageNum);
      const viewport = page.getViewport({ scale: currentScale });

      const card = document.createElement("div");
      card.className = "pdf-page-card";

      const canvas = document.createElement("canvas");
      canvas.className = "pdf-page-canvas";
      const context = canvas.getContext("2d", { alpha: false });

      const displayWidth = Math.floor(viewport.width);
      const displayHeight = Math.floor(viewport.height);

      canvas.width = Math.floor(displayWidth * pixelRatio);
      canvas.height = Math.floor(displayHeight * pixelRatio);
      canvas.style.width = `${displayWidth}px`;
      canvas.style.height = `${displayHeight}px`;

      card.appendChild(canvas);
      pagesContainer.appendChild(card);

      const transform = pixelRatio !== 1 ? [pixelRatio, 0, 0, pixelRatio, 0, 0] : null;

      await page.render({
        canvasContext: context!,
        viewport,
        transform,
      }).promise;
    }
  }

  async function fitToWidth() {
    if (!currentPdfDoc) return;
    const page = await currentPdfDoc.getPage(1);
    const unscaledViewport = page.getViewport({ scale: 1 });

    // Accurately compute available container width across mobile screen sizes
    const wrapperWidth = wrapper ? wrapper.clientWidth : 0;
    const fallbackWidth = window.innerWidth - 32;
    const availableWidth = Math.max(260, (wrapperWidth > 0 ? wrapperWidth - 24 : fallbackWidth));

    currentScale = Math.min(2.0, Math.max(MIN_SCALE, availableWidth / unscaledViewport.width));
    updateZoomLabel();
    await renderPages();
  }

  async function fitToPage() {
    currentScale = 1.0;
    updateZoomLabel();
    await renderPages();
  }

  async function init() {
    if (!pdfUrl || !pagesContainer) return;

    try {
      const loadingTask = pdfjsLib.getDocument({ url: pdfUrl });
      currentPdfDoc = await loadingTask.promise;

      if (loading) {
        loading.style.display = "none";
      }

      // Automatically fit to mobile screen width or default desktop scale
      if (window.innerWidth < 768) {
        await fitToWidth();
      } else {
        currentScale = 1.25;
        updateZoomLabel();
        await renderPages();
      }
    } catch (error) {
      console.error("PDF.js render error:", error);
      if (loading) {
        loading.innerHTML = `
          <div class="error-message">
            <p>${errorText}</p>
            <a href="${pdfUrl}" download class="download-btn" style="margin-top: 1rem; display: inline-flex;">
              Abrir / Descargar PDF
            </a>
          </div>
        `;
      }
    }
  }

  zoomInBtn?.addEventListener("click", async () => {
    if (currentScale < MAX_SCALE) {
      currentScale = Math.min(MAX_SCALE, currentScale + 0.15);
      updateZoomLabel();
      await renderPages();
    }
  });

  zoomOutBtn?.addEventListener("click", async () => {
    if (currentScale > MIN_SCALE) {
      currentScale = Math.max(MIN_SCALE, currentScale - 0.15);
      updateZoomLabel();
      await renderPages();
    }
  });

  fitWidthBtn?.addEventListener("click", fitToWidth);
  fitPageBtn?.addEventListener("click", fitToPage);

  // Re-fit on orientation change or window resize
  let resizeTimeout: any;
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(() => {
      if (window.innerWidth < 768) {
        fitToWidth();
      }
    }, 150);
  });

  init();
</script>
