{
  "i18n-ally.localesPaths": ["src/i18n/locales"],
  "i18n-ally.keystyle": "nested",
  "i18n-ally.sourceLanguage": "es",
  "i18n-ally.displayLanguage": "es",
  "i18n-ally.enabledParsers": ["json"],
  "i18n-ally.pathMatcher": "{locale}.json",
  "i18n-ally.enabledFrameworks": ["general"],
  "i18n-ally.includeSubdirs": false,
  "i18n-ally.extract.autoDetect": true,
  "i18n-ally.translate.fallbackToDump": true,
  "i18n-ally.keepFulfilled": true,
  "i18n-ally.annotation.enable": true,
  "i18n-ally.refactor.templates": [
    "t('{key}')"
  ],
  "i18n-ally.customFrameworks": [
    {
      "id": "astro-portfolio",
      "monorepo": false,
      "languageIds": ["astro", "typescript", "javascript", "typescriptreact", "javascriptreact"],
      "usage": {
        "patterns": [
          "t\\(['\"`]([\\w.-]+)['\"`]"
        ]
      }
    }
  ]
}
